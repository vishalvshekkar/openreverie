# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test and coverage
coverage/

# Environment and secrets. Never commit keys.
.env
.env.*

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local user data. A developer's own memory folder must never enter the repo.
.reverie/

# Agent working directories: specs and plans are committed under docs/,
# everything in here is scratch for a single session.
.superpowers/
.claude/

# Copied into the published openreverie package at bundle time
# (packages/cli/scripts/bundle.mjs), from the root files of the same
# names. Scoped with a leading slash so this can never match the root
# copies themselves.
/packages/cli/README.md
/packages/cli/LICENSE
